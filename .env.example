# ====================================================
# Bakery Management System - Environment Configuration
# ====================================================

# Security
SECRET_KEY=bakery-secret-key-production-strength-2026

# Database Configuration
# Leave DATABASE_URL empty to use local SQLite (sqlite:///bakery.db)
# Or configure for MySQL: mysql+pymysql://root:password@localhost:3306/bakery_db
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bakery_db

# Business Configuration
BAKERY_NAME=Sweet Delights Artisan Bakery
BAKERY_PHONE=+1 (555) 234-5678
BAKERY_EMAIL=contact@sweetdelightsbakery.com
BAKERY_ADDRESS=124 Sugarloaf Lane, Flour District, Suite 100
CURRENCY_SYMBOL=$
DEFAULT_TAX_PERCENT=5.00
DEFAULT_DISCOUNT_PERCENT=0.00
LOW_STOCK_THRESHOLD_DEFAULT=10.0
